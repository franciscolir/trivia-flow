rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Trivias: cualquiera puede leerlas (jugarlas);
    // solo usuarios autenticados pueden crearlas y solo su dueño las edita/elimina.
    match /trivias/{triviaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Sesiones: la pantalla pública las lee y el conductor las escribe.
    // Datos de competencia (no confidenciales) en un entorno de juego.
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
