rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Trivias: lectura y gestión desde el panel del conductor.
    // Entorno de juego local (herramienta de concursos), escritura pública.
    match /trivias/{triviaId} {
      allow read, write: if true;
    }

    // Sesiones: la pantalla pública las lee y el conductor las escribe.
    // Datos de competencia (no confidenciales) en un entorno de juego.
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
